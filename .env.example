# Email is optional. Either set SMTP_* here (read-only in the UI) or leave SMTP_HOST empty
# and configure SMTP from the Settings page (needs SETTINGS_ENCRYPTION_KEY below).
EMAIL_ADMIN=admin@voucherbox.local
EMAIL_SUBJECT=Email Voucher for your WiFi
SMTP_HOST=mail.smtp.com
SMTP_PORT=587
SMTP_USER=voucherbox@opnsense.local
SMTP_FROM="OPNsense VoucherBox <voucherbox@opnsense.local>"
SMTP_PASS="strong-pass-for-smtp-server"
SMTP_TLS=false
OPNSENSE_HOST=firewall.opnsense.local
# optional, default 443
#OPNSENSE_PORT=8443
API_USERNAME=api-user-from-opnsense
API_PASSWORD=api-key-from-opnsense
ALLOW_SELFSIGNED_HTTPS_CERTS=true
CAPTIVE_PORTAL_URL=http://redirect-portal:8000/
BASEPATH=/wifi/

# Voucher history (SQLite). Passwords are never stored.
#DATA_DIR=/app/data
# Default retention in days (0 = forever); can be changed by an admin in Settings
HISTORY_RETENTION_DAYS=365

# Login: none | local | oidc | local+oidc (default: oidc if OIDC_ISSUER_URL is set, otherwise none)
AUTH_MODE=local
LOCAL_ADMIN_USERNAME=admin
# at least 10 characters; only used to create the first admin (or with LOCAL_ADMIN_RESET_PASSWORD=true)
LOCAL_ADMIN_PASSWORD=change-me-please
#LOCAL_ADMIN_RESET_PASSWORD=false
# optional, at least 32 characters (otherwise generated and stored in the database)
#SESSION_SECRET=

# OIDC (with AUTH_MODE=oidc or local+oidc)
#OIDC_ISSUER_URL=https://auth.example.com/realms/example
#OIDC_CLIENT_ID=voucherbox
#OIDC_CLIENT_SECRET=client-secret
#PUBLIC_URL=https://voucher.example.com/wifi
#OIDC_USER_ROLE=voucherbox-user
#OIDC_ADMIN_ROLE=voucherbox-admin

# Key (>= 32 chars) used to encrypt secrets stored in the database, e.g. the SMTP password set in Settings
SETTINGS_ENCRYPTION_KEY=change-me-to-a-long-random-string-of-32-plus-chars
