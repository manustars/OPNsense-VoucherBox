# Email is optional: leave SMTP_HOST empty to disable it (voucher shown on page only)
EMAIL_ADMIN=admin@voucherbox.local
EMAIL_SUBJECT=Email Voucher for your WiFi
SMTP_HOST=mail.smtp.com
SMTP_PORT=587
SMTP_USER=voucherbox@opnsense.local
SMTP_FROM="OPNsense VoucherBox <voucherbox@opnsense.local>"
SMTP_PASS="strong-pass-for-smtp-server"
SMTP_TLS=false
OPNSENSE_HOST=firewall.opnsense.local
# optional, default 443
#OPNSENSE_PORT=8443
API_USERNAME=api-user-from-opnsense
API_PASSWORD=api-key-from-opnsense
ALLOW_SELFSIGNED_HTTPS_CERTS=true
CAPTIVE_PORTAL_URL=http://redirect-portal:8000/
BASEPATH=/wifi/

# Voucher history (SQLite). Passwords are never stored.
#DATA_DIR=/app/data
# Default retention in days (0 = forever); can be changed by an admin in Settings
HISTORY_RETENTION_DAYS=365

# Optional OIDC login (Keycloak, Authentik, ...). Leave OIDC_ISSUER_URL empty to disable.
#OIDC_ISSUER_URL=https://auth.example.com/realms/example
#OIDC_CLIENT_ID=voucherbox
#OIDC_CLIENT_SECRET=client-secret
#PUBLIC_URL=https://voucher.example.com/wifi
#SESSION_SECRET=at-least-32-random-characters-long
#OIDC_USER_ROLE=voucherbox-user
#OIDC_ADMIN_ROLE=voucherbox-admin
